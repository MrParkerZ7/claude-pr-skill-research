  ],
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('T008-guard no stack trace or exception class in the body', function () {",
          "  const body = pm.response.text();",
          "  pm.expect(body).to.not.match(/\"trace\"\\s*:|\"exception\"\\s*:|\\bat [\\w.$]+\\([\\w$]+\\.(?:java|kt):\\d+\\)/);",
          "});"
        ]
      }
    }
  ]
